{
  "manifest_version": 3,
  "name": "critter",
  "version": "0.1.0",
  "description": "In-page UI crit overlay",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Toggle critter",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
